@model Quodery.Web.Pages.NewPasswordPageModel
<label asp-for="Password">Password</label>
<input asp-for="Password" type="password" autocomplete="new-password" minlength="@UserAuthentication.MinimumPasswordLength" maxlength="@UserAuthentication.MaximumPasswordLength" required />
<label asp-for="ConfirmPassword">Confirm password</label>
<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="@UserAuthentication.MinimumPasswordLength" maxlength="@UserAuthentication.MaximumPasswordLength" required />
<p class="fieldHelp">At least @UserAuthentication.MinimumPasswordLength characters.</p>
