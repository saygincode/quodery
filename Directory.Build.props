<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <QuoderyRequestedVersion>$(Version)</QuoderyRequestedVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <Target Name="RequireQuoderyVersion" BeforeTargets="BeforeBuild">
    <Error Condition="'$(QuoderyRequestedVersion)' == ''"
           Text="No version given. Build with -p:Version=X.Y.Z, for example: dotnet publish cli/Quodery.Cli.csproj --configuration Release -p:Version=0.1.1" />
  </Target>
</Project>
