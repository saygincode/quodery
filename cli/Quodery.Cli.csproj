<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Quodery.Cli</RootNamespace>
    <AssemblyName>quodery</AssemblyName>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../runtime/Quodery.Runtime.csproj" />
    <ProjectReference Include="../web/Quodery.Web.csproj" />
  </ItemGroup>
</Project>
